# ex02.py - Construtor
class Produto:
    def __init__(self, nome, preco, estoque):
        self.nome = nome
        self.preco = preco
        self.estoque = estoque

p1 = Produto("Notebook", 3500.00, 10)
p2 = Produto("Mouse", 89.90, 50)

print(p1.nome, p1.preco, p1.estoque)
print(p2.nome, p2.preco, p2.estoque)
