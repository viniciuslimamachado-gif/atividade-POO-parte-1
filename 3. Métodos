# ex03.py - Métodos
class Aluno:
    def __init__(self, nome, nota):
        self.nome = nome
        self.nota = nota

    def aprovado(self):
        return self.nota >= 6

a1 = Aluno("Ana", 7.5)
a2 = Aluno("Bruno", 4.0)

print(a1.nome, "aprovado?", a1.aprovado())
print(a2.nome, "aprovado?", a2.aprovado())
